{
  "name": "bos-omega-brain",
  "version": "0.1.11",
  "description": "BOS-OMEGA Brain \u2014 OpenAI-compatible LLM gateway with self-auditor.",
  "main": "server.js",
  "type": "module",
  "bin": {
    "llm-audit": "bin/audit.mjs"
  },
  "scripts": {
    "start": "node server.js",
